{
  "settings": {
    "driveRootFolderName": "Medical Data",
    "drivePrivateFolderName": "Medical Sync - private",
    "driveReserveMB": 2048,
    "maxFileSizeMB": 4096,
    "runBudgetMinutes": 45,
    "rescanDays": 30
  },
  "europepmc": {
    "enabled": true,
    "licenses": [
      "cc by",
      "cc by-sa",
      "cc0",
      "cc by-nc",
      "cc by-nc-sa",
      "cc by-nd",
      "cc by-nc-nd"
    ],
    "minIntervalMs": 300,
    "maxPerQueryPerRun": 300,
    "queries": [
      {
        "name": "case-pathology",
        "folder": [
          "Patient case reports",
          "Pathology"
        ],
        "query": "PUB_TYPE:\"Case Reports\" AND (histopathology OR biopsy OR cytology OR \"bone marrow\" OR curettage)"
      },
      {
        "name": "case-imaging",
        "folder": [
          "Patient case reports",
          "Imaging"
        ],
        "query": "PUB_TYPE:\"Case Reports\" AND (\"computed tomography\" OR MRI OR radiograph OR ultrasound)"
      },
      {
        "name": "case-cardiology",
        "folder": [
          "Patient case reports",
          "Cardiology"
        ],
        "query": "PUB_TYPE:\"Case Reports\" AND (cardiology OR cardiac OR myocardial OR arrhythmia)"
      },
      {
        "name": "case-pulmonology",
        "folder": [
          "Patient case reports",
          "Pulmonology"
        ],
        "query": "PUB_TYPE:\"Case Reports\" AND (pulmonary OR lung OR respiratory)"
      },
      {
        "name": "case-neurology",
        "folder": [
          "Patient case reports",
          "Neurology"
        ],
        "query": "PUB_TYPE:\"Case Reports\" AND (neurology OR neurological OR seizure OR stroke)"
      },
      {
        "name": "case-oncology",
        "folder": [
          "Patient case reports",
          "Oncology"
        ],
        "query": "PUB_TYPE:\"Case Reports\" AND (carcinoma OR tumor OR lymphoma OR oncology)"
      },
      {
        "name": "case-gastro",
        "folder": [
          "Patient case reports",
          "Gastroenterology"
        ],
        "query": "PUB_TYPE:\"Case Reports\" AND (gastrointestinal OR colon OR gastric OR hepatic OR pancreatic)"
      },
      {
        "name": "case-endocrine",
        "folder": [
          "Patient case reports",
          "Endocrinology"
        ],
        "query": "PUB_TYPE:\"Case Reports\" AND (diabetes OR thyroid OR endocrine OR adrenal)"
      },
      {
        "name": "case-nephrology",
        "folder": [
          "Patient case reports",
          "Nephrology"
        ],
        "query": "PUB_TYPE:\"Case Reports\" AND (renal OR kidney OR nephrotic OR dialysis)"
      },
      {
        "name": "case-pediatrics",
        "folder": [
          "Patient case reports",
          "Pediatrics"
        ],
        "query": "PUB_TYPE:\"Case Reports\" AND (infant OR child OR pediatric OR neonatal)"
      },
      {
        "name": "case-emergency",
        "folder": [
          "Patient case reports",
          "Emergency & Critical Care"
        ],
        "query": "PUB_TYPE:\"Case Reports\" AND (\"emergency department\" OR \"intensive care\" OR trauma OR sepsis)"
      },
      {
        "name": "case-psychiatry",
        "folder": [
          "Patient case reports",
          "Psychiatry & Behavioral Health"
        ],
        "query": "PUB_TYPE:\"Case Reports\" AND (psychiatric OR depression OR schizophrenia OR bipolar)"
      },
      {
        "name": "education",
        "folder": [
          "Medical education cases"
        ],
        "query": "(\"teaching case\" OR \"educational case\" OR \"clinical vignette\" OR \"case-based learning\" OR \"clinical challenge\")"
      }
    ]
  },
  "ctgov": {
    "enabled": true,
    "requireDocuments": true,
    "minIntervalMs": 400,
    "maxStudiesPerQueryPerRun": 300,
    "queries": [
      {
        "name": "new",
        "folder": [
          "Studies",
          "New studies"
        ],
        "statuses": [
          "NOT_YET_RECRUITING",
          "RECRUITING"
        ]
      },
      {
        "name": "ongoing",
        "folder": [
          "Studies",
          "Ongoing studies"
        ],
        "statuses": [
          "ACTIVE_NOT_RECRUITING",
          "ENROLLING_BY_INVITATION"
        ]
      }
    ]
  },
